#!/bin/sh
# scx 一键安装（macOS / Linux / WSL）：
#   1) 以 release profile 构建（--locked，零第三方 crate，离线可构建）
#   2) 软链到 ~/.local/bin/scx（可用 SCX_BIN_DIR 覆盖目标目录）
# 幂等：重复执行只重建必要文件并刷新软链，不删除其他文件。
# Windows 用户：使用 bin/run.cmd 自举入口，或按 README「一键安装」复制二进制。
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$DIR")"
BIN_DIR="${SCX_BIN_DIR:-$HOME/.local/bin}"

if ! command -v cargo >/dev/null 2>&1; then
  echo "scx: 未找到 cargo。请先安装 Rust（macOS: brew install rust；其他: https://rustup.rs）。" >&2
  exit 3
fi

echo "[scx] release build (--locked) ..."
(cd "$ROOT" && cargo build --release --locked)

mkdir -p "$BIN_DIR"
ln -sf "$ROOT/target/release/scx" "$BIN_DIR/scx"

"$BIN_DIR/scx" --version
echo "installed: $BIN_DIR/scx"
echo "提示：若 $BIN_DIR 不在 PATH，可追加：export PATH=\"$BIN_DIR:\$PATH\""
