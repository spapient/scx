# 编译产物：跨机器只携带源码，二进制各平台本机构建（见 README）
bin/scx
bin/scx.exe
# 构建缓存（本机 cargo 直接构建时落在 rs/target）
rs/target/

# 评估生成的记忆库/临时目录：证据 CSV/JSON/verbose 单独提交，库目录不入库
eval-real/*-mem/
eval-real/*-mem-*/
eval-real/tmp-*
eval-real/archive-*/
eval-real/*-ablate/
eval-real/confirm5-ci*
eval-real/*-replay*

# 本地环境、密钥与系统/编辑器杂项
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
