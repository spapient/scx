#!/bin/sh
# scx 自举入口（macOS / Linux / WSL）：
# 自动检测本平台二进制：缺失或任一源码/清单更新时自动构建，然后原样转发全部参数。
# 无需手工准备二进制，无需跨平台同步产物；本机有 Rust 即可（没有会给出安装指引）。
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL="$(dirname "$DIR")"
BIN="$DIR/scx"
MANIFEST="$SKILL/Cargo.toml"
LOCK="$SKILL/Cargo.lock"
STALE=0
if [ ! -f "$BIN" ] || [ ! -x "$BIN" ]; then
  STALE=1
elif find "$SKILL/src" "$MANIFEST" "$LOCK" -newer "$BIN" -print -quit 2>/dev/null | grep -q .; then
  STALE=1
fi
if [ "$STALE" -eq 1 ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    echo "scx: 未找到 cargo。请先安装 Rust（macOS: brew install rust 或 https://rustup.rs），再重试。" >&2
    exit 3
  fi
  TD="${SCX_TARGET_DIR:-${TMPDIR:-/tmp}/scx-cargo-target}"
  cargo build --release --quiet --locked --manifest-path "$MANIFEST" --target-dir "$TD" >&2
  cp "$TD/release/scx" "$BIN"
  chmod +x "$BIN"
fi
exec "$BIN" "$@"
