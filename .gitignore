# 编译产物：跨机器只携带源码，二进制各平台本机构建（见 README）
# 构建缓存（本机 cargo 直接构建时落在 target）
/target/

# 评估生成的记忆库/临时产物：输入与冻结标签入库，库目录与统计输出不入库
config/*-mem/
config/*-mem-*/
config/ci-*
config/tmp-*
config/*-ablate/
config/*-replay*

# 本地环境、密钥与系统/编辑器杂项
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
