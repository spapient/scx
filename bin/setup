#!/usr/bin/env bash
# scx-mcp setup：构建 feature=mcp 二进制并打印客户端接入片段。
# 只输出配置片段到 stdout，绝不修改任何客户端配置文件。
set -euo pipefail
cd "$(dirname "$0")/.."
BIN=target/release/scx-mcp

echo "[scx-mcp] building release binary (features=mcp) ..."
cargo build --release --features mcp >/dev/null
if [ -x "$BIN" ]; then
  echo "ok: $BIN"
else
  echo "fail: build did not produce $BIN" >&2
  exit 1
fi
echo
echo "接入片段（stdout 输出，不写你的配置文件）："
echo
cat <<'SNIP'
# Claude Code（~/.claude.json 的 mcpServers 段追加）
"scx": {
  "command": "PATH_TO_REPO/target/release/scx-mcp",
  "type": "stdio"
}

# Cursor（~/.cursor/mcp.json 的 mcpServers 段追加）
{
  "mcpServers": {
    "scx": {
      "command": "PATH_TO_REPO/target/release/scx-mcp",
      "type": "stdio"
    }
  }
}
SNIP
echo
echo "路径中的 PATH_TO_REPO 替换为: $(cd "$(dirname "$0")/.." && pwd)"
echo "验证：bin/doctor"
